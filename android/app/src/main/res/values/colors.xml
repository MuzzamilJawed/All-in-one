<?xml version="1.0" encoding="utf-8"?>
<!--
  Only the launch-screen colour. colorPrimary / colorPrimaryDark / colorAccent
  are provided by the capacitor-android library — do not redeclare them here or
  the app theme silently changes.
-->
<resources>
    <!-- Matches the app's dark background so the hand-off from the native launch
         screen to the web splash has no colour flash. -->
    <color name="splash_background">#050505</color>
</resources>
