<?xml version="1.0" encoding="utf-8"?>
<!--
  Fully transparent launch icon.

  On Android 12+ the system always draws *something* in the launch window — the
  app icon if you don't name one. We only want the in-app splash to be seen, so
  the launch window is given this empty icon and shows nothing but its background
  colour, which matches the app background exactly.
-->
<vector
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="288dp"
    android:height="288dp"
    android:viewportWidth="288"
    android:viewportHeight="288">
    <path
        android:fillColor="#00000000"
        android:pathData="M0,0 L288,0 L288,288 L0,288 Z" />
</vector>
