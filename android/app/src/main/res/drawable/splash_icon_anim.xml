<?xml version="1.0" encoding="utf-8"?>
<!--
  Animated launch icon: the brand badge springs in, then a trend line draws
  itself across it. Replaces the flat splash.png, which could not move.

  Canvas is 288dp because that is what the Android 12 splash API expects; the
  artwork sits inside the inner 192dp so it is not clipped by the circular mask.
-->
<animated-vector
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">

    <aapt:attr name="android:drawable">
        <vector
            android:width="288dp"
            android:height="288dp"
            android:viewportWidth="288"
            android:viewportHeight="288">

            <group
                android:name="badge"
                android:pivotX="144"
                android:pivotY="144"
                android:scaleX="0.72"
                android:scaleY="0.72">
                <path
                    android:name="badgeShape"
                    android:fillColor="#2563EB"
                    android:pathData="M100,72 L188,72 A28,28 0 0 1 216,100 L216,188 A28,28 0 0 1 188,216 L100,216 A28,28 0 0 1 72,188 L72,100 A28,28 0 0 1 100,72 Z" />
            </group>

            <group android:name="trendGroup">
                <path
                    android:name="trend"
                    android:fillColor="#00000000"
                    android:strokeColor="#FFFFFF"
                    android:strokeWidth="10"
                    android:strokeLineCap="round"
                    android:strokeLineJoin="round"
                    android:trimPathStart="0"
                    android:trimPathEnd="0"
                    android:pathData="M100,178 L128,150 L156,166 L184,120 L206,100" />
                <path
                    android:name="tip"
                    android:fillColor="#FFFFFF"
                    android:fillAlpha="0"
                    android:pathData="M206,88 m-11,0 a11,11 0 1,0 22,0 a11,11 0 1,0 -22,0" />
            </group>
        </vector>
    </aapt:attr>

    <!-- Badge springs up to full size -->
    <target android:name="badge">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:propertyName="scaleX"
                    android:duration="480"
                    android:valueFrom="0.72"
                    android:valueTo="1"
                    android:valueType="floatType"
                    android:interpolator="@android:interpolator/overshoot" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:duration="480"
                    android:valueFrom="0.72"
                    android:valueTo="1"
                    android:valueType="floatType"
                    android:interpolator="@android:interpolator/overshoot" />
            </set>
        </aapt:attr>
    </target>

    <!-- Then the line draws left to right -->
    <target android:name="trend">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="trimPathEnd"
                android:duration="620"
                android:startOffset="260"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>

    <!-- Marker pops at the leading edge as the line lands -->
    <target android:name="tip">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillAlpha"
                android:duration="220"
                android:startOffset="820"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType"
                android:interpolator="@android:interpolator/decelerate_quad" />
        </aapt:attr>
    </target>
</animated-vector>
