<?xml version="1.0" encoding="utf-8"?>
<!--
  Full-screen version shown by the Capacitor splash after the launch window.
  Same ring + badge composition, same background — so the hand-off between the
  two native layers is invisible and the user sees a single splash from the tap
  until the app paints.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_background" />
    <item
        android:width="288dp"
        android:height="288dp"
        android:gravity="center"
        android:drawable="@drawable/splash_web_icon" />
</layer-list>
