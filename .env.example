# MongoDB connection string.
MONGODB_URI=mongodb://localhost:27017/solo-trackr

# ── Authentication ──────────────────────────────────────────────────────────
# Signs the session cookie. REQUIRED in production — without it the app falls
# back to a known development secret and anyone could forge a session.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Google sign-in. Create an OAuth 2.0 "Web application" client at
# https://console.cloud.google.com/apis/credentials and add your app's origin
# (e.g. http://localhost:3005) under "Authorized JavaScript origins".
# Leave blank to hide the Google button and use email/password only.
GOOGLE_CLIENT_ID=

# Set to false when serving a production build over plain HTTP (e.g. the
# Capacitor LAN setup below) — otherwise the session cookie is dropped.
# COOKIE_SECURE=false

# ── Password reset (forgot password) ────────────────────────────────────────
# Public origin of the app, used to build the reset link that goes out with a
# verified code. Leave blank to derive it from the request (fine locally; set
# it when the app sits behind a proxy or is loaded by the Capacitor shell).
APP_URL=

# The one-time code is emailed — there is no SMS channel. Delivery is through
# https://resend.com; MAIL_FROM must be an address on a domain verified there.
RESEND_API_KEY=
MAIL_FROM=SoloTrackr <no-reply@your-domain.com>

# Or send it yourself: this URL receives POST {channel,to,subject,text,html,code}
# and is used when no Resend key is set.
# NOTIFY_WEBHOOK_URL=
# NOTIFY_WEBHOOK_TOKEN=
#
# With neither set, a *development* server prints the code to the terminal (and
# shows it on the verify screen) so the flow is testable. A production build
# refuses to send instead of silently swallowing the code.

# ── Seeded admin account ────────────────────────────────────────────────────
# Created automatically on the first database connection. Change the password
# before deploying — the default below is for local development only.
SEED_ADMIN_EMAIL=admin@solotrackr.app
SEED_ADMIN_PASSWORD=admin12345
SEED_ADMIN_NAME=Administrator

# ── Mobile ──────────────────────────────────────────────────────────────────
# Capacitor: the URL the native Android/iOS app loads (your deployed Next.js server).
# Production:  https://your-domain.com
# LAN dev:     http://<your-machine-LAN-IP>:3005  (phone on same Wi-Fi as `npm run dev`)
CAP_SERVER_URL=http://192.168.1.20:3005
